# =============================================================================
# Admin Agent v2.x — Environment Configuration
# Multi-provider AI | Template-Ready Architecture
# =============================================================================

# ─── Operator / Vouza fallback (used by Docker compose + start.bat) ─────────
# If set, the Guide Bot uses this key when the customer hasn't pasted their
# own AI key yet. The agent's $10/day cost guard ONLY enforces against this
# key — customer-supplied keys are uncapped.
VOUZA_API_KEY=sk-or-v1-xxxxx
VOUZA_API_PROVIDER=openrouter
VOUZA_API_MODEL=google/gemini-2.5-flash-lite
VOUZA_BRAND_NAME=Vouza

# ─── Remote dashboard access (only if exposing beyond localhost) ────────────
# Default is loopback-only (no LAN exposure). If you set DASHBOARD_BIND to
# a non-loopback address, DASHBOARD_PASSWORD becomes MANDATORY (the agent
# refuses to start without it).
DASHBOARD_BIND=127.0.0.1
DASHBOARD_PASSWORD=

# ─── AI Provider API Keys (set the ONE for your selected provider) ──────────
ANTHROPIC_API_KEY=sk-ant-xxxxx
OPENAI_API_KEY=sk-proj-xxxxx
GOOGLE_AI_API_KEY=AIzaSyxxxxx
XAI_API_KEY=xai-xxxxx
DEEPSEEK_API_KEY=sk-xxxxx
DASHSCOPE_API_KEY=sk-xxxxx
MOONSHOT_API_KEY=sk-xxxxx
OPENROUTER_API_KEY=sk-or-xxxxx

# ─── Gmail ────────────��─────────────────────────────────────────────────────
GMAIL_USER=your@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
GMAIL_EMAIL_ADDRESS=your@gmail.com

# ─── Unified Google (Calendar, Sheets, Drive, Docs) ────────────────────────
GOOGLE_SERVICE_ACCOUNT_KEY=./credentials/google-sa.json

# ─── Slack ──────────────────��────────────────���──────────────────────────────
SLACK_BOT_TOKEN=xoxb-xxxxx

# ─── Telegram ──────────────���────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNO
TELEGRAM_WEBHOOK_URL=

# ─── WhatsApp (choose one provider) ────────────────────────────────────────
# Option 1: WhatsApp Web (QR code, free)
WHATSAPP_WEB_ENABLED=false
WHATSAPP_WEB_SERVER=http://localhost:3001

# Option 2: Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_WHATSAPP_NUMBER=+14155238886

# Option 3: Meta Cloud API
META_WHATSAPP_ACCESS_TOKEN=EAAxxxxxxx
META_WHATSAPP_PHONE_NUMBER_ID=1234567890

# Option 4: WAHA (self-hosted)
WAHA_SERVER_URL=http://localhost:3000
WAHA_API_KEY=
WAHA_SESSION=default

# ─── Agent Config ───────────────��───────────────────────────────────────────
AGENT_NAME=AdminAgent
AGENT_MODEL=claude-sonnet-4-6
AI_PROVIDER=anthropic
MEMORY_DIR=./data/memory
SKILLS_DIR=./src/skills/bundled
LOG_DIR=./data/logs
SELF_IMPROVE_INTERVAL_HOURS=24
MAX_TURNS_PER_SESSION=20
DASHBOARD_PORT=3456

# ─── Privacy & local AI ─────────────────────────────────────────────────────
# Local AI (Ollama) — set AI_PROVIDER=ollama and AGENT_MODEL to an installed
# model (e.g. qwen2.5:7b). Nothing is sent to an AI company. Quick Setup can do this too.
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# Minutes between connection health checks (default 15 min, minimum 60000 ms)
# HEALTH_PROBE_INTERVAL_MS=900000
# Name/URL sent to OpenRouter for attribution (defaults: Vouza Admin Agent / https://vouza.ai)
# VOUZA_APP_NAME=
# VOUZA_APP_URL=
