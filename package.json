{
  "name": "admin-agent",
  "version": "2.1.0",
  "description": "Self-improving AI agent framework — multi-provider, template-ready, inspired by Claude Code architecture",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs');fs.cpSync('src/dashboard/public','dist/dashboard/public',{recursive:true,force:true});console.log('✓ public/ copied to dist/')\"",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "setup": "tsx src/dashboard/launch.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:watch": "node --import tsx --test --watch tests/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@whiskeysockets/baileys": "7.0.0-rc13",
    "adm-zip": "^0.6.0",
    "chalk": "^5.3.0",
    "dotenv": "^16.4.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "googleapis": "^144.0.0",
    "gray-matter": "^4.0.3",
    "imapflow": "^1.4.2",
    "mailparser": "^3.9.11",
    "mammoth": "^1.12.0",
    "node-cron": "^3.0.3",
    "node-notifier": "^10.0.1",
    "nodemailer": "^9.0.1",
    "pdf-parse": "^2.4.5",
    "pino": "^9.14.0",
    "playwright": "1.60.0",
    "qrcode": "^1.5.4",
    "zod": "^3.23.0"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "html-to-text": "10.0.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/express": "^5.0.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.0",
    "@types/node-notifier": "^8.0.5",
    "@types/nodemailer": "^6.4.17",
    "@types/pdf-parse": "^1.1.5",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
